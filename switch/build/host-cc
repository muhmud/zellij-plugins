#!/usr/bin/env bash
# Host linker for build scripts and proc macros.
#
# rustc drives host links through the toolchain's bundled lld
# (-fuse-ld=lld -B .../gcc-ld). On this machine that ld.lld is a nix wrapper
# script pointing at a garbage-collected store path, so the link fails. Drop
# those two arguments and let cc use the system linker.
args=()
for a in "$@"; do
  case "$a" in
    -fuse-ld=lld) ;;
    -B*gcc-ld) ;;
    *) args+=("$a") ;;
  esac
done
exec cc "${args[@]}"
